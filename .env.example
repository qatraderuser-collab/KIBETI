# Copy to .env and fill in. Never commit the real .env — it is gitignored.
# kibetistore/settings.py loads this file with python-dotenv before store/payments.py reads it.

# Django. Generate a key with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# ALLOWED_HOSTS is comma-separated and only safe empty while DEBUG=True on localhost.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# Safaricom Daraja. Live mode turns on only when SHORTCODE, PASSKEY, KEY, SECRET and CALLBACK
# are ALL present; otherwise the store runs in demo mode with a simulated STK prompt.
DARAJA_KEY=
DARAJA_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# Public HTTPS URL of the mpesa_callback view, including the secret path segment below, e.g.
# https://your-domain.co.ke/mpesa/callback/<MPESA_CALLBACK_SECRET>/
DARAJA_CALLBACK=
# Safaricom sends no auth header on an STK callback, so this path segment is the only credential
# that authenticates it. Generate with: python -c "import secrets; print(secrets.token_hex(16))"
MPESA_CALLBACK_SECRET=

# Set to https://api.safaricom.co.ke for production; defaults to the sandbox.
# DARAJA_BASE=
